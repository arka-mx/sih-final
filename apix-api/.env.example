APP_ENV=development

# Supabase Postgres connection string. Get this from your Supabase project:
# Project Settings -> Database -> Connection string -> URI, using the
# "Transaction pooler" (port 6543) host for serverless/short-lived
# connections, or the direct connection (port 5432) for long-lived ones like
# the pipeline scheduler. Must use the asyncpg driver prefix and the DB
# password you set when creating the project (URL-encode any special
# characters in it). Supabase requires SSL, which asyncpg negotiates
# automatically against its endpoints.
DATABASE_URL=postgresql+asyncpg://postgres.xxxxxxxxxxxx:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
REDIS_URL=redis://localhost:6379/0

# Optional: enables scrapers/amadeus_fare_scraper.py, a real live-fare source
# via the Amadeus Self-Service Flight Offers Search API (free test-tier
# signup at https://developers.amadeus.com/register). Left unset, this
# source is skipped cleanly and the pipeline continues on the simulated
# sources -- see get_amadeus_scraper_if_configured().
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
