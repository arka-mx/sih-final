# Next.js Frontend Local Environment
# FastAPI Backend Service URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# Demo Personas (Local Development Only)
NEXT_PUBLIC_DEMO_NSO_KEY=mospi-nso-key-2026
NEXT_PUBLIC_DEMO_RBI_KEY=rbi-mpd-key-2026

# Server-side only: used by app/api/* proxy routes to authenticate against the
# FastAPI backend on the dashboard's behalf. Never exposed to the browser.
APIX_API_BASE_URL=http://localhost:8001
APIX_SERVER_API_KEY=mospi-nso-key-2026

# Set to "true" to render the dashboard from static sample data in
# lib/mockData.ts instead of the live backend (offline demo mode).
NEXT_PUBLIC_DEMO_MODE=false
